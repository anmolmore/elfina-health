modules = ["nodejs-20"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Companion App"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Booking App"

[[workflows.workflow]]
name = "Companion App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd elfina-platform && PORT=5000 node services/companion-app/src/index.mjs"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow]]
name = "Booking App"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd elfina-platform && PORT=3000 node services/booking-app/src/index.mjs"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "webview"
